# Maintainer: Xscriptor <dev@xscriptor.com>
pkgname=x-dev
pkgver=1.0
pkgrel=2
pkgdesc="X development environment — shell config and dev tooling"
arch=('any')
url="https://xscriptor.io/x"
license=('MIT')
depends=('zsh' 'git' 'base-devel' 'curl' 'wget')
install=x-dev.install
source=()
md5sums=()

package() {
    install -Dm755 /dev/stdin "$pkgdir/usr/bin/x-dev-env" <<'XDEVENV'
#!/usr/bin/env bash
set -euo pipefail
[ "$EUID" -eq 0 ] && { echo "Run as regular user, not root."; exit 1; }
log()  { echo -e "\033[1;32m[X]\033[0m $1"; }
warn() { echo -e "\033[1;33m[!]\033[0m $1"; }
run() { sudo "$@"; }

for rc in "$HOME/.zshrc" "$HOME/.bashrc"; do
  [ -f "$rc" ] && sed -i '/^[[:space:]]*alias[[:space:]]*x=.*$/d' "$rc" 2>/dev/null || true
done

if ! command -v zsh &>/dev/null; then
  log "Installing zsh..."
  run pacman -Sy --noconfirm zsh
fi

if command -v pacman &>/dev/null && ! command -v yay &>/dev/null; then
  log "Installing yay..."
  run pacman -Sy --noconfirm --needed git base-devel
  tmpdir=$(mktemp -d)
  git clone https://aur.archlinux.org/yay.git "$tmpdir"
  (cd "$tmpdir" && makepkg -si --noconfirm)
  rm -rf "$tmpdir"
fi

if [ "$SHELL" != "$(which zsh)" ] && command -v zsh &>/dev/null; then
  chsh -s "$(which zsh)" && log "Default shell set to zsh"
fi

if [ ! -d "$HOME/.oh-my-zsh" ]; then
  log "Installing Oh My Zsh..."
  export RUNZSH=no
  sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)"
fi

ZSH_CUSTOM="${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}"
declare -A plugins=(
  ["zsh-autosuggestions"]="https://github.com/zsh-users/zsh-autosuggestions"
  ["zsh-syntax-highlighting"]="https://github.com/zsh-users/zsh-syntax-highlighting"
  ["zsh-completions"]="https://github.com/zsh-users/zsh-completions"
)
for name in "${!plugins[@]}"; do
  dest="$ZSH_CUSTOM/plugins/$name"
  [ -d "$dest" ] || git clone --depth=1 "${plugins[$name]}" "$dest"
done

ZSHRC="$HOME/.zshrc"
[ -f "$ZSHRC" ] || touch "$ZSHRC"
sed -i 's/^ZSH_THEME=.*/ZSH_THEME="random"/' "$ZSHRC" || echo 'ZSH_THEME="random"' >> "$ZSHRC"
if grep -q "^plugins=" "$ZSHRC"; then
  sed -i 's/^plugins=.*/plugins=(git zsh-autosuggestions zsh-syntax-highlighting zsh-completions)/' "$ZSHRC"
else
  echo 'plugins=(git zsh-autosuggestions zsh-syntax-highlighting zsh-completions)' >> "$ZSHRC"
fi

ALIASES="# ───── X Aliases ─────
alias xs='sudo su'
alias xi='sudo -i'
alias xsh='sudo -s'
alias xzdev='zellij --layout x'"

GIT_ALIASES="# ===== XCustom Git Aliases =====
alias gc=\"git clone\"
alias ga=\"git add .\"
alias gcom=\"git commit -m\"
alias gp=\"git push\"
alias gpuom=\"git push -u origin main\"
alias gpuod=\"git push -u origin dev\"
alias gs=\"git status\"
alias gl=\"git log --oneline --graph --decorate\"
alias gco=\"git checkout\"
alias gcb=\"git checkout -b\"
alias gd=\"git diff\"
alias gpl=\"git pull\"
alias gf=\"git fetch\"
# ===== End ====="

NAV_ALIASES="# ===== XCustom Navigation Aliases =====
alias ..=\"cd ..\"
alias ...=\"cd ../..\"
alias ....=\"cd ../../..\"
alias ~=\"cd ~\"
alias c=\"clear\"
alias ll=\"ls -lh\"
alias la=\"ls -A\"
alias l=\"ls -CF\"
# ===== End ====="

for rc in "$HOME/.zshrc" "$HOME/.bashrc"; do
  [ -f "$rc" ] || continue
  grep -q "X Aliases" "$rc" 2>/dev/null || echo "$ALIASES" >> "$rc"
  grep -q "XCustom Git Aliases" "$rc" 2>/dev/null || echo "$GIT_ALIASES" >> "$rc"
  grep -q "XCustom Navigation Aliases" "$rc" 2>/dev/null || echo "$NAV_ALIASES" >> "$rc"
done

if command -v code &>/dev/null; then
  log "Installing VSCode extensions..."
  code --install-extension xscriptor.x-dark-colors 2>/dev/null || warn "Failed x-dark-colors"
  code --install-extension xscriptor.xscriptor-themes 2>/dev/null || warn "Failed xscriptor-themes"
  code --install-extension xscriptor.xglass 2>/dev/null || warn "Failed xglass"
fi

log "Installing X tools..."
curl -fsSL https://raw.githubusercontent.com/xfetch-cli/xfetch/main/install.sh | bash 2>/dev/null || warn "xfetch failed"
curl -fsSL https://raw.githubusercontent.com/xscriptor/xtop/main/install.sh | bash 2>/dev/null || warn "xtop failed"

log "Done! Reload your shell: source ~/.zshrc"
XDEVENV

    install -Dm755 /dev/stdin "$pkgdir/usr/share/x-dev/apply-system.sh" <<'SYS'
#!/usr/bin/env bash
set -euo pipefail
ALIASES="# ───── X Aliases ─────
alias xs='sudo su'
alias xi='sudo -i'
alias xsh='sudo -s'
alias xzdev='zellij --layout x'"
GIT_ALIASES="# ===== XCustom Git Aliases =====
alias gc=\"git clone\"
alias ga=\"git add .\"
alias gcom=\"git commit -m\"
alias gp=\"git push\"
alias gpuom=\"git push -u origin main\"
alias gpuod=\"git push -u origin dev\"
alias gs=\"git status\"
alias gl=\"git log --oneline --graph --decorate\"
alias gco=\"git checkout\"
alias gcb=\"git checkout -b\"
alias gd=\"git diff\"
alias gpl=\"git pull\"
alias gf=\"git fetch\"
# ===== End ====="
NAV_ALIASES="# ===== XCustom Navigation Aliases =====
alias ..=\"cd ..\"
alias ...=\"cd ../..\"
alias ....=\"cd ../../..\"
alias ~=\"cd ~\"
alias c=\"clear\"
alias ll=\"ls -lh\"
alias la=\"ls -A\"
alias l=\"ls -CF\"
# ===== End ====="
for rc in /etc/bash.bashrc /etc/zsh/zshrc; do
  if [ -f "$rc" ]; then
    grep -q "X Aliases" "$rc" 2>/dev/null || echo "$ALIASES" >> "$rc"
    grep -q "XCustom Git Aliases" "$rc" 2>/dev/null || echo "$GIT_ALIASES" >> "$rc"
    grep -q "XCustom Navigation Aliases" "$rc" 2>/dev/null || echo "$NAV_ALIASES" >> "$rc"
  fi
done
SYS

    install -Dm755 /dev/stdin "$pkgdir/usr/share/x-dev/nvidia.sh" <<'NVEOF'
#!/usr/bin/env bash
set -euo pipefail
log() { echo -e "\033[1;32m[XOs]\033[0m $1"; }
warn() { echo -e "\033[1;33m[!]\033[0m $1"; }
run() { if command -v x &>/dev/null; then x "$@"; elif [ "$EUID" -ne 0 ]; then sudo "$@"; else "$@"; fi; }
log "Installing NVIDIA drivers..."
MULTILIB=false; grep -q "^\[multilib\]" /etc/pacman.conf && MULTILIB=true
pacman -Q vulkan-nouveau xf86-video-nouveau &>/dev/null && run pacman -Rns --noconfirm vulkan-nouveau xf86-video-nouveau || true
PKGS="nvidia nvidia-utils nvidia-settings opencl-nvidia egl-wayland"
$MULTILIB && PKGS="$PKGS lib32-nvidia-utils lib32-opencl-nvidia"
run pacman -S --noconfirm --needed $PKGS
MKINIT=/etc/mkinitcpio.conf
if [ -f "$MKINIT" ] && ! grep -q nvidia_drm "$MKINIT"; then
  run cp "$MKINIT" "${MKINIT}.bak"
  run sed -i 's/^MODULES=(\(.*\))/MODULES=(nvidia nvidia_modeset nvidia_uvm nvidia_drm \1)/' "$MKINIT"
  run mkinitcpio -P
fi
if command -v bootctl &>/dev/null && bootctl is-installed &>/dev/null; then
  for f in /boot/loader/entries/*.conf; do
    [ -f "$f" ] || continue
    grep -q "nvidia-drm.modeset=1" "$f" || run sed -i '/^options/ s/$/ nvidia-drm.modeset=1/' "$f"
    grep -q "nvidia-drm.fbdev=1" "$f" || run sed -i '/^options/ s/$/ nvidia-drm.fbdev=1/' "$f"
  done
elif [ -f /boot/grub/grub.cfg ]; then
  GRUB=/etc/default/grub
  CUR=$(grep "^GRUB_CMDLINE_LINUX_DEFAULT=" "$GRUB" | cut -d'"' -f2)
  NEW="$CUR"
  [[ "$CUR" != *"nvidia-drm.modeset=1"* ]] && NEW="$NEW nvidia-drm.modeset=1"
  [[ "$CUR" != *"nvidia-drm.fbdev=1"* ]] && NEW="$NEW nvidia-drm.fbdev=1"
  [ "$CUR" != "$NEW" ] && { run sed -i "s/^GRUB_CMDLINE_LINUX_DEFAULT=\".*\"/GRUB_CMDLINE_LINUX_DEFAULT=\"$NEW\"/" "$GRUB"; run grub-mkconfig -o /boot/grub/grub.cfg; }
fi
run bash -c 'echo "options nvidia_drm modeset=1 fbdev=1" > /etc/modprobe.d/nvidia.conf'
run systemctl enable --now nvidia-suspend.service nvidia-hibernate.service nvidia-resume.service nvidia-powerd.service || true
log "Done! Reboot required."
NVEOF

    install -Dm755 /dev/stdin "$pkgdir/usr/share/x-dev/nvm.sh" <<'NVMEOF'
#!/usr/bin/env bash
set -euo pipefail
log() { echo -e "\033[1;32m[XOs]\033[0m $1"; }
log "Installing fnm + Node.js..."
command -v fnm &>/dev/null || curl -fsSL https://fnm.vercel.app/install | bash -s -- --skip-shell
FNM_PATH="$HOME/.local/share/fnm"
SHELL_CONFIG=""
case "$SHELL" in */zsh) SHELL_CONFIG="$HOME/.zshrc" ;; */bash) SHELL_CONFIG="$HOME/.bashrc" ;; */fish) SHELL_CONFIG="$HOME/.config/fish/config.fish" ;; esac
if [ -n "$SHELL_CONFIG" ] && [ -f "$SHELL_CONFIG" ] && ! grep -q "fnm env" "$SHELL_CONFIG"; then
  echo -e "\n# fnm\nexport PATH=\"$FNM_PATH:\$PATH\"\neval \"\$(fnm env --use-on-cd)\"" >> "$SHELL_CONFIG"
fi
export PATH="$FNM_PATH:$PATH"
eval "$(fnm env --use-on-cd)"
fnm install --lts && fnm use --lts
npm install -g npm@latest yarn pnpm typescript ts-node
log "Node $(node -v) — npm $(npm -v)"
NVMEOF

    install -Dm755 /dev/stdin "$pkgdir/usr/share/x-dev/qemu.sh" <<'QEMUEOF'
#!/usr/bin/env bash
set -euo pipefail
log() { echo -e "\033[1;32m[XOs]\033[0m $1"; }
run() { if command -v x &>/dev/null; then x "$@"; elif [ "$EUID" -ne 0 ]; then sudo "$@"; else "$@"; fi; }
log "Installing QEMU + Libvirt..."
run pacman -S --needed --noconfirm qemu-desktop libvirt virt-manager virt-viewer dnsmasq vde2 bridge-utils openbsd-netcat edk2-ovmf swtpm iptables-nft guestfs-tools
run systemctl enable --now libvirtd.service virtlogd.socket virtlockd.socket
run usermod -aG libvirt,kvm,input "$(whoami)"
[ -f /usr/share/libvirt/networks/default.xml ] && run virsh net-define /usr/share/libvirt/networks/default.xml 2>/dev/null || true
run virsh net-autostart default || true && run virsh net-start default || true
log "Done! Log out/in, then run virt-manager."
QEMUEOF
}
