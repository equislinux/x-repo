post_install() {
    if [ -f /usr/share/x-dev/apply-system.sh ]; then
        bash /usr/share/x-dev/apply-system.sh
    fi

    echo ""
    echo "=== X Dev Environment ==="
    echo "Run 'x-dev-env' as your regular user to complete setup:"
    echo "  - Install Oh My Zsh & plugins"
    echo "  - Install yay (AUR helper)"
    echo "  - Install VSCode extensions"
    echo "  - Install xfetch, xtop, ghostty, ptyxis"
    echo "  - Set zsh as default shell"
    echo "  - Configure shell aliases"
    echo "=========================="
}

post_upgrade() {
    post_install
}
